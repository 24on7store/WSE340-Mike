<%- include('partials/header') %>
<main>
    <% if (project) { %>
        <h1><%= project.title %></h1>
        <p><strong>Description:</strong> <%= project.description %></p>
        <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        
        <p><strong>Partner Organization:</strong> 
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>
    <!-- Add after receiving feedback on week03 TC and NF 
    Uses typeof to gracefully skip tags if the controller array arrives blank -->
        <h3>Project Categories:</h3>
        <div class="category-tags" style="display: flex; gap: 10px; margin-top: 10px;">
            <% if (typeof tags !== 'undefined' && tags && tags.length > 0) { %>
                <% tags.forEach(tag => { %>
                    <a href="/category/<%= tag.category_id %>" style="background: #e0e0e0; padding: 5px 10px; border-radius: 4px; text-decoration: none; color: #333;">
                        <%= tag.name %>
                    </a>
                <% }) %>
            <% } else { %>
                <p>No categories assigned to this project.</p>
            <% } %>
        </div>

        <!-- FIXED LINK: Moved inside the if statement and changed to project.project_id -->
        <p style="margin-top: 20px;">
            <!-- Look for your existing edit and assign links and modify them -->
            <% if (user && user.role_name === 'admin') { %>
                <p><a href="/edit-project/<%= project.project_id %>">Edit Project Details</a></p>
                <p><a href="/assign-categories/<%= project.project_id %>">Manage Project Categories</a></p>
            <% } %>

        </p>

    <% } else { %>
        <h1>Project Not Found</h1>
        <p>The requested service project details could not be found.</p>
    <% } %>
    <p><a href="/projects">← Back to Upcoming Projects</a></p>
</main>

