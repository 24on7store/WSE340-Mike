<!--Added on week05 #5 STEP2-->
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <!--ADDED ON WEEK05 AR-->
    <% if (user && user.role_name === 'admin') { %>
    <div class="admin-controls" style="margin-top: 20px; background: #f4f4f4; padding: 15px; border-radius: 5px;">
        <h3>Administrative Tools</h3>
        <p><a href="/admin/users" class="btn">👥 Manage Registered Users</a></p>
    </div>
<% } %>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

</main>

<!--ADDED ON WEEK06-->
<h2>My Volunteered Service Projects</h2>
<% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
    <ul class="volunteered-list">
        <% volunteeredProjects.forEach(p => { %>
            <li style="margin-bottom: 12px;">
                <a href="/project/<%= p.project_id %>"><strong><%= p.title %></strong></a> - <%= p.location %>
                <a href="/project/<%= p.project_id %>/unvolunteer?from=dashboard" style="color: red; margin-left: 15px; font-size: 0.9em;">[Cancel Registration]</a>
            </li>
        <% }) %>
    </ul>
<% } else { %>
    <p>You haven't signed up to volunteer for any projects yet.</p>
<% } %>


<%- include('partials/footer') %>