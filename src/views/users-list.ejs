<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email / Username</th>
                <th>System Role</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(u => { %>
                <tr>
                    <td><%= u.name %></td>
                    <td><%= u.email %></td>
                    <td><strong><%= u.role_name %></strong></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</main>
<%- include('partials/footer') %>
