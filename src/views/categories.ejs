<%- include('partials/header') %>
<main>
    <h1>Service Categories</h1>
    <p>Browse projects by category:</p>

    
    <ul class="categories-list">
        <% categories.forEach(category => { %>
            <li>
                <!-- Clickable title to browse projects -->
                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>

                <!--ADDED ON WEEK 04 AR-->
        
                <a href="/edit-category/<%= category.category_id %>" style="font-size: 0.85em; color: red; text-decoration: underline;">
                        Edit
                    </a>
    
            </li>
        <% }); %>
    

    <!--ADDED ON WEEK 04 AR-->
    <p>
        <a href="/new-category">
            + Add a New Category
        </a>
    </p>
    </ul>
</main>
<%- include('partials/footer') %>
